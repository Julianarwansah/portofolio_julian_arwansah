rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidMessage() {
      request.resource.data.keys().hasOnly(['text', 'uid', 'displayName', 'photoURL', 'createdAt'])
      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 300
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.createdAt == request.time
      && (request.resource.data.displayName == null
          || request.resource.data.displayName == request.auth.token.name)
      && (request.resource.data.photoURL == null
          || request.resource.data.photoURL == request.auth.token.picture);
    }

    match /messages/{messageId} {
      allow read: if true;

      allow create: if request.auth != null && isValidMessage();

      // Messages are immutable. Moderate spam from the Firebase console,
      // which runs with admin privileges and bypasses these rules.
      allow update, delete: if false;
    }
  }
}
